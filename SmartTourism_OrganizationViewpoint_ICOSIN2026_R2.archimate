  <folder name="Motivation" id="id-6b48cb5f089a494eb937d55569d94487" type="motivation">
    <folder name="Reference architecture" id="id-3b13974fe1584e9994d27cc6b5e9a5ae">
      <element xsi:type="archimate:Outcome" name="Tourist value co-creation" id="id-24a80f22a2744c4581535663c9bfb326">
        <documentation>Chuang (2023): tourist value co-creation behaviours enabled by smart tourism services.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Tourism sustainability" id="id-27462c7d33864dc49e9af65dc4af87a8" />
    </folder>
    <folder name="Pontianak baseline (as-is)" id="id-6a7c00fa6cbb4bb4b2efb0e11db678f8">
      <element xsi:type="archimate:Goal" name="Improve city brand value through local economic uniqueness" id="id-023554cec3d84e8cb4b4381e6de56100">
        <documentation>Pontianak Smart City Masterplan 2019-2028.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="A1. Orchestrator role unassigned; DCI and DYST pursue the goal in separate processes" id="id-dc69ce54b7284bea8d6a9e0bce0b8ce5" />
      <element xsi:type="archimate:Assessment" name="A2. No role in DYST owns tourism technology" id="id-304d399201364b0fbd9c70d261eeafb7" />
      <element xsi:type="archimate:Assessment" name="A3. Heritage content has no path into the platform" id="id-4b38baeb7f7b43fcb12a67e55057a4b6" />
      <element xsi:type="archimate:Assessment" name="A4. Data roles concentrated in DCI teams with siloed applications" id="id-67a7124d6916482ea20d98f7fbe080e6" />
      <element xsi:type="archimate:Assessment" name="A5. Suppliers and intermediaries absent from the initiative" id="id-ec475299533445bb90614ce6d3e23ac0" />
    </folder>
    <folder name="Pontianak target (to-be)" id="id-7d3cd575f38741ac917b0918a781b23d">
      <element xsi:type="archimate:Outcome" name="Tourist value co-creation" id="id-eec07591a95f40b187bfc942a84806e1" />
      <element xsi:type="archimate:Goal" name="Improve city brand value through local economic uniqueness" id="id-1d9c9345a8d94ce4b0de82dcedbff110">
        <documentation>Pontianak Smart City Masterplan 2019-2028.</documentation>
      </element>
    </folder>
  </folder>
